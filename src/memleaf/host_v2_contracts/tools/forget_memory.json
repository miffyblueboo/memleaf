          "protocol_version": {
            "const": "memleaf-host-v2.0-rc1"
          },
          "mode": {
            "const": "preview"
          },
          "request_id": {
            "$ref": "#/$defs/Id"
          },
          "memory_ids": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/MemoryId"
            },
            "minItems": 1,
            "maxItems": 8,
            "uniqueItems": true
          }
        },
        "required": [
          "protocol_version",
          "mode",
          "request_id",
          "memory_ids"
        ],
        "additionalProperties": false
      },
      "ForgetApplyRequest": {
        "type": "object",
        "properties": {
          "protocol_version": {
            "const": "memleaf-host-v2.0-rc1"
          },
          "mode": {
            "const": "apply"
          },
          "request_id": {
            "$ref": "#/$defs/Id"
          },
          "deletion_plan_id": {
            "$ref": "#/$defs/Id"
          },
          "expected_plan_revision": {
            "$ref": "#/$defs/Revision"
          },
          "approval_ref": {
            "$ref": "#/$defs/Id"
          }
        },
        "required": [
          "protocol_version",
          "mode",
          "request_id",
          "deletion_plan_id",
          "expected_plan_revision",
          "approval_ref"
        ],
        "additionalProperties": false
