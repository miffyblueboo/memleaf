              "properties": {
                "has_more": {
                  "const": false
                }
              }
            },
            "then": {
              "properties": {
                "next_cursor": {
                  "const": null
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "has_more": {
                  "const": true
                }
              }
            },
            "then": {
              "properties": {
                "next_cursor": {
