+"""Host-owned visible event identity and external memory tool binding.
+
+No tool schemas or provider-specific names live here. The same immutable
+context follows a completed turn and its tool dispatches, across background work.
+"""
+from copy import deepcopy
+from contextlib import contextmanager
+from contextvars import ContextVar
+
+_binding = ContextVar('external_memory_tool_binding', default=None)
+
+
+def _visible_event(message, content):
+    from agent.message_metadata import stamp_message_uid
+    event = {'role': 'user', 'message_uid': stamp_message_uid(message),
+             'content': deepcopy(content)}
+    for key in ('source_time', 'timestamp', 'source_sequence'):
+        if key in message:
+            event[key] = deepcopy(message[key])
+    return event
+
+
+def begin_memory_turn(agent, messages, user_index, visible_content=None):
+    from agent.message_metadata import stamp_message_uid
+    message = messages[user_index]
+    agent._memory_turn_context = {
+        'version': 1, 'session_id': agent.session_id or '',
+        'turn_id': agent._current_turn_id, 'turn_number': agent._user_turn_count,
+        'user_message_ids': [stamp_message_uid(message)],
+        'user_events': [_visible_event(message, message.get('content') if visible_content is None else visible_content)],
+        'source_time': message.get('source_time', message.get('timestamp')),
+    }
+
+
+def register_memory_correction(agent, message):
+    from agent.message_metadata import stamp_message_uid
+    context = getattr(agent, '_memory_turn_context', None)
+    if isinstance(context, dict) and context.get('turn_id') == getattr(agent, '_current_turn_id', None):
+        context['user_message_ids'].append(stamp_message_uid(message))
+        context['user_events'].append(_visible_event(message, message.get('content')))
+
+
+@contextmanager
+def bind_memory_tools(manager, context, api_request_id=''):
+    token = _binding.set((manager, deepcopy(context), api_request_id))
+    try:
+        yield
+    finally:
+        _binding.reset(token)
+
+
+def bind_external_arguments(name, args, call_id):
+    value = _binding.get()
+    if value is None or value[0] is None:
+        return args
+    manager, context, api_request_id = value
+    binder = getattr(manager, 'bind_external_tool_call', None)
+    if binder is None:
+        return args
+    return binder(name, args, turn_context=context,
+                  tool_call_id=f'{api_request_id}/{call_id or ""}')
+
+
+def current_memory_tool_binding():
+    """Return the dispatch planning snapshot inherited by a worker, if present."""
+    return _binding.get()
+
+
+def complete_memory_turn(agent, messages, assistant_content, *, turn_id):
+    """Freeze admitted source events against this completed reply, before enqueue.
+
+    Compaction may remove every admitted user from the model's API transcript.
+    The host's admission ledger, not that lossy transcript, proves provenance.
+    """
+    context = getattr(agent, '_memory_turn_context', None)
+    if (not isinstance(context, dict)
+            or not isinstance(turn_id, str) or not turn_id
+            or context.get('turn_id') != turn_id
+            or getattr(agent, '_current_turn_id', None) != turn_id
+            or not messages or not isinstance(messages[-1], dict)):
+        raise ValueError('memory completion identity mismatch')
+    final = messages[-1]
+    if (final.get('role') != 'assistant' or final.get('content') != assistant_content
+            or final.get('tool_calls')):
+        raise ValueError('memory completion reply mismatch')
+    from agent.message_metadata import stamp_message_uid
+    result = deepcopy(context)
+    result['completed_assistant_message_id'] = stamp_message_uid(final)
+    return result
